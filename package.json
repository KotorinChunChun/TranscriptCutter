{
  "name": "transcript-cutter",
  "version": "0.2611.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run build:web && tauri build --no-bundle",
    "dev": "npm run build:web && tauri dev",
    "test:dialogue": "node --experimental-strip-types --loader ./scripts/ts-test-loader.mjs --test dialogue/tests/*.test.mjs",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  }
}
